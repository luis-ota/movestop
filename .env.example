# MOVESTOP duel server — copie para .env (Bun carrega .env automaticamente).
# Nunca faça commit de segredos. Este arquivo lista apenas configuração pública.

# Porta HTTP/WebSocket dentro do container/VM. O TLS é terminado no proxy.
# Default do servidor e do Docker. Para o dev com o proxy atual do Vite em
# 8788, rode `PORT=8788 bun run server` ou ajuste o proxy em vite.config.ts.
PORT=8788

# Origens exatas permitidas no handshake WebSocket, separadas por vírgula.
# Ex.: https://movestop.example.com,https://www.movestop.example.com
# Sem wildcard. A origem do próprio host que serve o app é sempre aceita.
# Em desenvolvimento, http://localhost:<porta> e http://127.0.0.1:<porta>
# também são aceitas automaticamente.
ALLOWED_ORIGINS=

# Tetos de capacidade. MAX_ROOMS é limitado a 200 pelo servidor.
MAX_ROOMS=200

# Só habilite atrás de um proxy reverso confiável (Traefik/Cloudflare).
# O servidor prefere CF-Connecting-IP e cai para o primeiro X-Forwarded-For.
# A origem precisa aceitar somente IPs do Cloudflare; senão o cliente falsifica
# o IP e fura o limite de conexões. 0 = usa o endereço do socket.
TRUST_PROXY=1

# O Dockerfile já define NODE_ENV=production. Rodando direto com Bun, defina
# NODE_ENV=production para exigir Origin no WebSocket e desabilitar atalhos de
# desenvolvimento (localhost e ausência de Origin).
# NODE_ENV=production
